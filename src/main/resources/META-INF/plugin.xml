<idea-plugin>
    <!-- The id and the name must both be unique on the Marketplace: the upstream plugin already owns
         "com.hlsl.plugin" and "HLSL Language Support". -->
    <id>com.hlsl.dx12.support</id>
    <name>HLSL Language Support (DX12)</name>
    <vendor>DOCC</vendor>
    <description><![CDATA[
        Syntax highlighting and DXC validation for HLSL (High Level Shading Language) files.
        Supports .hlsl and .hlsli file extensions by default.
        Additional extensions (.fx, .fxh, .vsh, .psh, .gsh, .csh, etc.) can be added via Settings > Editor > File Types > HLSL.
    ]]></description>
    <change-notes><![CDATA[
        <ul>
            <li>Attributes such as numthreads, unroll and domain are completed with their parentheses and closing
                bracket.</li>
            <li>Semantics such as SV_DispatchThreadID are completed while the function has no body yet.</li>
            <li>Intrinsic functions such as reversebits and built-in types such as RWTexture2D are explained on
                hover, and Ctrl+Click opens their declaration in a read-only built-ins file.</li>
            <li>Ctrl+Click on the path of an #include opens the included file.</li>
            <li>Semantics such as SV_Target, SV_Position, TEXCOORD0, register and the interpolation modifiers
                are explained on hover, in English or Chinese.</li>
            <li>Enter indents blocks, a control statement written without braces indents its body, and a
                closing brace is aligned with the line that opened the block.</li>
            <li>Pasting keeps the shape of a block instead of indenting it on top of the indentation it
                already carried.</li>
            <li>A DXC diagnostic underlines the symbol it is about instead of the rest of the line.</li>
            <li>Custom colour palette for types, struct names, function calls and variables, adjustable per theme.</li>
            <li>Completion of struct members through the include chain, resource intrinsics and chained calls.</li>
            <li>Parameter info and hover documentation built from the declaration and the comment above it.</li>
            <li>DXC validation with project build macro detection, so guarded shader code is not reported as broken.</li>
            <li>clang-format integration for Reformat Code.</li>
        </ul>
    ]]></change-notes>

    <!-- No <url> element here: the 2024.1 descriptor schema has no such top-level element and the platform
         rejects the whole plugin when it sees one, which silently disables every extension in it. -->

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="HLSL File"
                implementationClass="com.hlsl.HlslFileType"
                fieldName="INSTANCE"
                language="HLSL"
                extensions="hlsl;hlsli"/>

        <lang.parserDefinition
                language="HLSL"
                implementationClass="com.hlsl.parser.HlslParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="HLSL"
                implementationClass="com.hlsl.highlighting.HlslSyntaxHighlighterFactory"/>

        <colorSettingsPage
                implementation="com.hlsl.highlighting.HlslColorSettingsPage"/>

        <lang.commenter
                language="HLSL"
                implementationClass="com.hlsl.HlslCommenter"/>

        <lang.braceMatcher
                language="HLSL"
                implementationClass="com.hlsl.HlslBraceMatcher"/>

        <lang.foldingBuilder
                language="HLSL"
                implementationClass="com.hlsl.folding.HlslFoldingBuilder"/>

        <completion.contributor
                language="HLSL"
                implementationClass="com.hlsl.completion.HlslCompletionContributor"/>

        <codeInsight.parameterInfo
                language="HLSL"
                implementationClass="com.hlsl.parameterinfo.HlslParameterInfoHandler"/>

        <typedHandler implementation="com.hlsl.parameterinfo.HlslParameterInfoTypedHandler"/>

        <lineIndentProvider implementation="com.hlsl.editor.HlslLineIndentProvider"/>

        <enterHandlerDelegate implementation="com.hlsl.editor.HlslSmartEnterHandler"/>

        <typedHandler implementation="com.hlsl.editor.HlslClosingBraceHandler"/>

        <copyPastePostProcessor implementation="com.hlsl.editor.HlslPasteIndentProcessor"/>

        <!-- Declared before the provider that shows declarations: the platform stops at the first provider
             that claims the hovered element, and semantics and built-ins must not be resolved as
             declarations. -->
        <lang.documentationProvider
                language="HLSL"
                implementationClass="com.hlsl.documentation.HlslSemanticsDocumentationProvider"/>

        <lang.documentationProvider
                language="HLSL"
                implementationClass="com.hlsl.documentation.HlslBuiltinDocumentationProvider"/>

        <lang.documentationProvider
                language="HLSL"
                implementationClass="com.hlsl.documentation.HlslDocumentationProvider"/>

        <platform.backend.documentation.psiTargetProvider
                implementation="com.hlsl.documentation.HlslDocumentationTargetProvider"/>

        <liveTemplateContext implementation="com.hlsl.templates.HlslTemplateContextType"/>

        <defaultLiveTemplatesProvider implementation="com.hlsl.templates.HlslLiveTemplatesProvider"/>

        <psi.referenceContributor
                language="HLSL"
                implementation="com.hlsl.navigation.HlslReferenceContributor"/>

        <gotoDeclarationHandler
                implementation="com.hlsl.navigation.HlslGotoDeclarationHandler"/>

        <annotator
                language="HLSL"
                implementationClass="com.hlsl.highlighting.HlslStructNameAnnotator"/>

        <externalAnnotator
                language="HLSL"
                implementationClass="com.hlsl.validation.HlslDxcAnnotator"/>

        <applicationConfigurable
                parentId="tools"
                instance="com.hlsl.validation.HlslDxcConfigurable"
                id="com.hlsl.validation.HlslDxcConfigurable"
                displayName="HLSL / DXC"/>

        <applicationService
                serviceImplementation="com.hlsl.validation.HlslDxcSettings"/>

        <intentionAction>
            <language>HLSL</language>
            <className>com.hlsl.intentions.HlslAddDxcPragmasIntention</className>
            <category>HLSL</category>
        </intentionAction>

        <formattingService
                implementation="com.hlsl.formatting.HlslClangFormatService"/>

        <applicationService
                serviceImplementation="com.hlsl.formatting.HlslClangFormatSettings"/>

        <applicationConfigurable
                parentId="tools"
                instance="com.hlsl.formatting.HlslClangFormatConfigurable"
                id="com.hlsl.formatting.HlslClangFormatConfigurable"
                displayName="HLSL / clang-format"/>

        <notificationGroup
                id="HLSL clang-format"
                displayType="BALLOON"/>
    </extensions>
</idea-plugin>
